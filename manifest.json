{
  "manifest_version": 3,
  "name": "Curious YouTube",
  "version": "1.16.1",
  "description": "Watch what you're curious about, not the algorithm's dictate. Turns YouTube into a clean search engine: no feed, no Shorts.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "web_accessible_resources": [
    {
      "resources": ["wallpapers/*", "logo.png"],
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "css": ["content.css"],
      "js": ["content.js", "settings-ui.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
